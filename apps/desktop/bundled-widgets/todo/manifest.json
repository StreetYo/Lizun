{
  "id": "lizun.todo",
  "name": "To-do",
  "version": "1.0.0",
  "author": "Lizun",
  "description": "A short list of tasks at hand",
  "entry": "index.html",
  "width": 260,
  "permissions": ["storage", "activity"],
  "settings": [
    {
      "key": "completed",
      "type": "select",
      "label": "Completed tasks",
      "default": "bottom",
      "options": [
        { "value": "inPlace", "label": "Keep in place" },
        { "value": "bottom", "label": "Move to the bottom" },
        { "value": "hidden", "label": "Hide" }
      ]
    },
    {
      "key": "newOnTop",
      "type": "toggle",
      "label": "Add new tasks to the top",
      "default": false
    },
    {
      "key": "showInIsland",
      "type": "toggle",
      "label": "Show the next task in the closed island",
      "description": "The first open task and how many more are left.",
      "default": true
    }
  ],
  "locales": {
    "ru": {
      "name": "Задачи",
      "description": "Короткий список текущих дел",
      "settings": {
        "completed": {
          "label": "Выполненные задачи",
          "options": { "inPlace": "Оставлять на месте", "bottom": "Переносить вниз", "hidden": "Скрывать" }
        },
        "newOnTop": { "label": "Добавлять новые задачи наверх" },
        "showInIsland": {
          "label": "Показывать следующую задачу в закрытом острове",
          "description": "Первая невыполненная задача и сколько ещё осталось."
        }
      }
    }
  }
}
